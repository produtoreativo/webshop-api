{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", {
      "tsconfig": "tsconfig.json",
      "isolatedModules": false
    }]
  },
  "setupFilesAfterEnv": ["<rootDir>/test/jest.setup.ts"],
  "moduleNameMapper": {
    "@config/(.*)$": "<rootDir>/src/config/$1",
    "@group-buying/(.*)$": "<rootDir>/src/group-buying/$1"
  },
  "collectCoverage": true,
  "collectCoverageFrom": [
    "<rootDir>/src/**/*.ts",
    "!<rootDir>/src/**/*.module.ts",
    "!<rootDir>/src/main.ts",
    "!<rootDir>/src/**/*.spec.ts"
  ],
  "reporters": [
    "default",
    [
      "jest-junit",
      {
        "outputDirectory": "<rootDir>/test/coverage-e2e",
        "outputName": "test-report.xml"
      }
    ]
  ],
  "coverageDirectory": "<rootDir>/test/coverage-e2e",
  "coverageReporters": [
    "text",
    "lcov",
    "json",
    "html"
  ],
  "coverageThreshold": {
    "global": {
      "statements": 0,
      "branches": 0,
      "functions": 0,
      "lines": 0
    },
    "./src/group-buying/**/*.ts": {
      "statements": 90,
      "branches": 90,
      "functions": 90,
      "lines": 90
    },
    "./src/filters/**/*.ts": {
      "statements": 90,
      "branches": 90,
      "functions": 90,
      "lines": 90
    }
  }
}
